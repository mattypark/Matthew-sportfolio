{
  "functions": {
    "api/lut-download.js": {
      "includeFiles": "private/**"
    },
    "api/stripe-webhook.js": {
      "includeFiles": "private/**"
    }
  },
  "rewrites": [
    {
      "source": "/ingest/static/:path*",
      "destination": "https://us-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://us.i.posthog.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

# Copy this file to .env and fill in the values. .env is gitignored — it never
# leaves your machine.
#
# Only `npm run draft` reads these. The site itself does not need them.

# Kit → Settings → Developer → API Keys → create a v4 key
KIT_API_KEY=

# Your live domain. Used to turn the post's relative links and cover image into
# absolute URLs, because relative URLs are dead inside an email.
SITE_URL=https://your-domain.com

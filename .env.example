# Copy this file to .env and fill in the values. .env is gitignored — it never
# leaves your machine.
#
# Only `npm run draft` reads these. The site itself does not need them.

# Kit → Settings → Developer → API Keys → create a v4 key
KIT_API_KEY=

# Your live domain. Used to turn the post's relative links and cover image into
# absolute URLs, because relative URLs are dead inside an email.
SITE_URL=https://your-domain.com

# --- /lut ---------------------------------------------------------------
# These live in Vercel (Project → Settings → Environment Variables), not here —
# api/lut-download.js is the only thing that reads them.

# Stripe → Developers → API keys → Secret key. Verifies that a thank-you page
# visitor actually paid before the .cube is handed over.
STRIPE_SECRET_KEY=

# Direct-download URL for the LUT you sell. This repo is public, so the .cube
# must never be committed — host it unlisted (Drive / Dropbox / Vercel Blob)
# and point this at it. Leave blank to read private/matthew-lut.cube instead,
# which only works locally under `vercel dev`.
LUT_FILE_URL=
